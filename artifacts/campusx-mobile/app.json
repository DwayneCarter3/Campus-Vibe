{
  "expo": {
    "name": "CampusX",
    "owner": "CarterThe3rd",
    "slug": "campusx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campusx-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090912"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#090912"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "devDomain": "campus-vibe-carterthe3rd.replit.dev"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#090912"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
